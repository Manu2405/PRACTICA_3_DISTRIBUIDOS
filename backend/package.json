{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend NestJS - Sistema Distribuido de Boletaje Aéreo",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "start:dev": "ts-node --transpile-only src/main.ts",
    "start:backend": "ts-node --transpile-only src/main.ts",
    "start:debug": "ts-node src/main.ts",
    "test": "jest --testPathPattern=algoritmia --no-coverage",
    "test:watch": "jest --testPathPattern=algoritmia --watch",
    "test:all": "jest --no-coverage",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "import:flights": "ts-node --transpile-only scripts/import-flights.ts",
    "db:reset-secondary": "ts-node --transpile-only scripts/reset-secondary.ts"
  },
  "prisma": {
    "seed": "ts-node --transpile-only src/prisma/seed.ts"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@prisma/client": "^5.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dijkstrajs": "^1.0.3",
    "dotenv": "^16.4.5",
    "mongodb": "^7.1.1",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.0.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.5.0",
    "prisma": "^5.0.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0"
  }
}
