generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model Aeropuerto {
  id            Int      @id(map: "PK__Aeropuer__3213E83F63F41FC8") @default(autoincrement())
  codigo        String   @unique(map: "UQ__Aeropuer__40F9A20688846D1F") @db.VarChar(10)
  nombre        String   @db.VarChar(100)
  ciudad        String   @db.VarChar(100)
  pais          String   @default("Bolivia", map: "DF__Aeropuerto__pais__38996AB5") @db.VarChar(100)
  creadoEn      DateTime @default(dbgenerated("sysdatetimeoffset()"), map: "DF__Aeropuert__cread__398D8EEE") @map("creado_en") @db.DateTimeOffset
  vuelosDestino Vuelo[]  @relation("VueloDestino")
  vuelosOrigen  Vuelo[]  @relation("VueloOrigen")

  @@map("Aeropuertos")
}

model Aeronave {
  id           Int      @id(map: "PK__Aeronave__3213E83FD77F4209") @default(autoincrement())
  modelo       String   @unique
  capacidadEco Int      @map("capacidad_eco")
  capacidadBus Int      @default(0, map: "DF__Aeronaves__capac__3C69FB99") @map("capacidad_bus")
  capacidadPri Int      @default(0, map: "DF__Aeronaves__capac__3D5E1FD2") @map("capacidad_pri")
  creadoEn     DateTime @default(dbgenerated("sysdatetimeoffset()"), map: "DF__Aeronaves__cread__3E52440B") @map("creado_en") @db.DateTimeOffset
  vuelos       Vuelo[]

  @@map("Aeronaves")
}

model Vuelo {
  id            Int        @id(map: "PK__Vuelos__3213E83FDBA10475") @default(autoincrement())
  numeroVuelo   String     @unique(map: "UQ__Vuelos__D2A6C6205286915D") @map("numero_vuelo") @db.VarChar(20)
  origenId      Int        @map("origen_id")
  destinoId     Int        @map("destino_id")
  aeronaveId    Int        @map("aeronave_id")
  salidaUtc     DateTime   @map("salida_utc") @db.DateTimeOffset
  llegadaUtc    DateTime   @map("llegada_utc") @db.DateTimeOffset
  precioBaseUsd Decimal    @map("precio_base_usd") @db.Decimal(10, 2)
  activo        Boolean    @default(true, map: "DF__Vuelos__activo__44FF419A")
  creadoEn      DateTime   @default(dbgenerated("sysdatetimeoffset()"), map: "DF__Vuelos__creado_e__45F365D3") @map("creado_en") @db.DateTimeOffset
  asientos      Asiento[]
  aeronave      Aeronave   @relation(fields: [aeronaveId], references: [id], onUpdate: NoAction, map: "FK__Vuelos__aeronave__440B1D61")
  destino       Aeropuerto @relation("VueloDestino", fields: [destinoId], references: [id], onUpdate: NoAction, map: "FK__Vuelos__destino___4316F928")
  origen        Aeropuerto @relation("VueloOrigen", fields: [origenId], references: [id], onUpdate: NoAction, map: "FK__Vuelos__origen_i__4222D4EF")

  @@map("Vuelos")
}

model ClaseTarifaria {
  id            Int       @id(map: "PK__ClasesTa__3213E83FD94AD00B") @default(autoincrement())
  codigo        String    @unique(map: "UQ__ClasesTa__40F9A2064A5B51EC") @db.VarChar(10)
  nombre        String    @db.VarChar(50)
  multiplicador Decimal   @default(1.0, map: "DF__ClasesTar__multi__49C3F6B7") @db.Decimal(4, 2)
  asientos      Asiento[]

  @@map("ClasesTarifarias")
}

model Asiento {
  id          Int                @id(map: "PK__Asientos__3213E83F4267558A") @default(autoincrement())
  vueloId     Int                @map("vuelo_id")
  claseId     Int                @map("clase_id")
  numero      String             @db.VarChar(5)
  estado      String             @default("LIBRE", map: "DF__Asientos__estado__4F7CD00D") @db.VarChar(20)
  creadoEn    DateTime           @default(dbgenerated("sysdatetimeoffset()"), map: "DF__Asientos__creado__5165187F") @map("creado_en") @db.DateTimeOffset
  anulaciones Anulacion[]
  clase       ClaseTarifaria     @relation(fields: [claseId], references: [id], onUpdate: NoAction, map: "FK__Asientos__clase___4E88ABD4")
  vuelo       Vuelo              @relation(fields: [vueloId], references: [id], onUpdate: NoAction, map: "FK__Asientos__vuelo___4D94879B")
  auditoria   AuditoriaAsiento[]
  reservas    Reserva[]
  ventas      Venta[]

  @@unique([vueloId, numero], map: "UQ__Asientos__040549542BB88106")
  @@map("Asientos")
}

model Pasajero {
  id          Int         @id(map: "PK__Pasajero__3213E83F29ED7520") @default(autoincrement())
  nombre      String      @db.VarChar(100)
  apellido    String      @db.VarChar(100)
  documento   String      @unique(map: "UQ__Pasajero__A25B3E61820BA9F2") @db.VarChar(30)
  email       String?     @db.VarChar(150)
  creadoEn    DateTime    @default(dbgenerated("sysdatetimeoffset()"), map: "DF__Pasajeros__cread__5535A963") @map("creado_en") @db.DateTimeOffset
  anulaciones Anulacion[]
  reservas    Reserva[]
  ventas      Venta[]

  @@map("Pasajeros")
}

model Reserva {
  id          Int         @id(map: "PK__Reservas__3213E83FF73BDE93") @default(autoincrement())
  asientoId   Int         @map("asiento_id")
  pasajeroId  Int         @map("pasajero_id")
  nodoOrigen  String      @default("NODO_1", map: "DF__Reservas__nodo_o__59FA5E80") @map("nodo_origen") @db.VarChar(20)
  relojVector String?     @map("reloj_vector") @db.VarChar(100)
  creadoEn    DateTime    @default(dbgenerated("sysdatetimeoffset()"), map: "DF__Reservas__creado__5AEE82B9") @map("creado_en") @db.DateTimeOffset
  expiraEn    DateTime?   @map("expira_en") @db.DateTimeOffset
  estado      String      @default("ACTIVA", map: "DF__Reservas__estado__5BE2A6F2") @db.VarChar(20)
  anulaciones Anulacion[]
  asiento     Asiento     @relation(fields: [asientoId], references: [id], onUpdate: NoAction, map: "FK__Reservas__asient__5812160E")
  pasajero    Pasajero    @relation(fields: [pasajeroId], references: [id], onUpdate: NoAction, map: "FK__Reservas__pasaje__59063A47")
  ventas      Venta[]

  @@map("Reservas")
}

model Venta {
  id          Int         @id(map: "PK__Ventas__3213E83F24BAA09D") @default(autoincrement())
  asientoId   Int         @map("asiento_id")
  pasajeroId  Int         @map("pasajero_id")
  reservaId   Int?        @map("reserva_id")
  montoUsd    Decimal     @map("monto_usd") @db.Decimal(10, 2)
  nodoOrigen  String      @default("NODO_1", map: "DF__Ventas__nodo_ori__628FA481") @map("nodo_origen") @db.VarChar(20)
  relojVector String?     @map("reloj_vector") @db.VarChar(100)
  creadoEn    DateTime    @default(dbgenerated("sysdatetimeoffset()"), map: "DF__Ventas__creado_e__6383C8BA") @map("creado_en") @db.DateTimeOffset
  estado      String      @default("CONFIRMADA", map: "DF__Ventas__estado__6477ECF3") @db.VarChar(20)
  anulaciones Anulacion[]
  asiento     Asiento     @relation(fields: [asientoId], references: [id], onUpdate: NoAction, map: "FK__Ventas__asiento___5FB337D6")
  pasajero    Pasajero    @relation(fields: [pasajeroId], references: [id], onUpdate: NoAction, map: "FK__Ventas__pasajero__60A75C0F")
  reserva     Reserva?    @relation(fields: [reservaId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK__Ventas__reserva___619B8048")

  @@map("Ventas")
}

model Anulacion {
  id          Int      @id(map: "PK__Anulacio__3213E83F77AAE878") @default(autoincrement())
  asientoId   Int      @map("asiento_id")
  pasajeroId  Int      @map("pasajero_id")
  reservaId   Int?     @map("reserva_id")
  ventaId     Int?     @map("venta_id")
  motivo      String?  @db.VarChar(200)
  tipo        String   @db.VarChar(20)
  nodoOrigen  String   @default("NODO_1", map: "DF__Anulacion__nodo___6D0D32F4") @map("nodo_origen") @db.VarChar(20)
  relojVector String?  @map("reloj_vector") @db.VarChar(100)
  creadoEn    DateTime @default(dbgenerated("sysdatetimeoffset()"), map: "DF__Anulacion__cread__6E01572D") @map("creado_en") @db.DateTimeOffset
  asiento     Asiento  @relation(fields: [asientoId], references: [id], onUpdate: NoAction, map: "FK__Anulacion__asien__68487DD7")
  pasajero    Pasajero @relation(fields: [pasajeroId], references: [id], onUpdate: NoAction, map: "FK__Anulacion__pasaj__693CA210")
  reserva     Reserva? @relation(fields: [reservaId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK__Anulacion__reser__6A30C649")
  venta       Venta?   @relation(fields: [ventaId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK__Anulacion__venta__6B24EA82")

  @@map("Anulaciones")
}

model AuditoriaAsiento {
  id           Int      @id(map: "PK__Auditori__3213E83F4B7877DA") @default(autoincrement())
  asientoId    Int      @map("asiento_id")
  estadoDesde  String   @map("estado_desde") @db.VarChar(20)
  estadoHasta  String   @map("estado_hasta") @db.VarChar(20)
  operacion    String   @db.VarChar(20)
  referenciaId Int?     @map("referencia_id")
  nodoOrigen   String   @default("NODO_1", map: "DF__Auditoria__nodo___71D1E811") @map("nodo_origen") @db.VarChar(20)
  relojVector  String?  @map("reloj_vector") @db.VarChar(100)
  timestampUtc DateTime @default(dbgenerated("sysdatetimeoffset()"), map: "DF__Auditoria__times__72C60C4A") @map("timestamp_utc") @db.DateTimeOffset
  asiento      Asiento  @relation(fields: [asientoId], references: [id], onUpdate: NoAction, map: "FK__Auditoria__asien__70DDC3D8")

  @@map("AuditoriaAsientos")
}
