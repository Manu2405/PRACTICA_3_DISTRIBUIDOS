# Copiar este archivo a .env (en la carpeta backend/) y ajustar.
# La base de datos debe existir antes de `db:push` (CREATE DATABASE en SSMS).
# Documentación: https://www.prisma.io/docs/orm/reference/connection-urls#sql-server

# --- Autenticación de Windows (como en SSMS: "Autenticación de Windows") ---
# Sustituye el host: nombre del equipo o localhost. Si usas instancia nombrada (ej. SQLEXPRESS):
# DATABASE_URL="sqlserver://TU_PC\\SQLEXPRESS;database=aviones_distribuidos;integratedSecurity=true;encrypt=true;trustServerCertificate=true"
DATABASE_URL="sqlserver://TU_PC;database=aviones_distribuidos;integratedSecurity=true;encrypt=true;trustServerCertificate=true"

# --- Autenticación SQL (usuario sa u otro) ---
# DATABASE_URL="sqlserver://sa:TuPassword@localhost:1433;database=aviones_distribuidos;encrypt=true;trustServerCertificate=true"
# --- SQL Server secundario / respaldo para replicacion logica ---
# Debe tener el mismo schema y los mismos datos base que la principal.
# Si no se configura, la replica secundaria queda deshabilitada sin romper el backend.
# SECONDARY_DATABASE_URL="sqlserver://TU_PC;database=aviones_distribuidos_secundaria;integratedSecurity=true;encrypt=true;trustServerCertificate=true"

# --- Mongo local para auditoria y proyeccion documental ---
# MONGODB_URI="mongodb://localhost:27017"
# MONGODB_DB_NAME="sarp_auditoria"
# MONGODB_COLLECTION_EVENTOS="eventos_operaciones"
